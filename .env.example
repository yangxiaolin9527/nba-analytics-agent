# Copy this file to .env.local and fill in values for local development.
# Runtime reads configuration only from repository-root .env.local.
# This file is a copy template and is never a runtime configuration source.

# Read-only SQLite database built from the fixed Eoin v515 snapshot
NBA_DB_PATH=/tmp/nba-m1.sqlite

# Optional live knowledge/mixed mode: existing dense index, one process at a time
NBA_KNOWLEDGE_INDEX_PATH=data/indexes/knowledge-500-dense

# OpenAI-compatible chat / Text-to-SQL model
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Embedding provider (reserved for the RAG stage)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Explicit embedding experiment settings. New indexes must be rebuilt when these change.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_DIMENSION=1536
EMBEDDING_NORMALIZE=false
EMBEDDING_LOCAL_DEVICE=cuda
EMBEDDING_LOCAL_BATCH_SIZE=8
EMBEDDING_LOCAL_MAX_LENGTH=2048

# Web search provider (reserved for a later stage)
SEARCH_BASE_URL=
SEARCH_API_KEY=
SEARCH_MODEL=

# Optional request settings
MODEL_TIMEOUT_SECONDS=30
AGENT_DECISION_TIMEOUT_SECONDS=20
# Unified Agent experiment: delegate only mixed/comparison model plans to the
# internal bounded loop. Keep disabled until the evaluation gate is passed.
NBA_AGENT_UNIFIED_LOOP_ENABLED=0
EMBEDDING_TIMEOUT_SECONDS=30

# Knowledge-answer online request budgets (seconds). The planner budget includes
# provider latency. Each stage is capped by the remaining total deadline.
# Stage ceilings are not reserved quotas; their sum may exceed the total.
KNOWLEDGE_MODEL_TIMEOUT_SECONDS=11
KNOWLEDGE_PLANNER_TIMEOUT_SECONDS=10
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=12
KNOWLEDGE_RETRIEVAL_TIMEOUT_SECONDS=24
KNOWLEDGE_GENERATION_TIMEOUT_SECONDS=10
KNOWLEDGE_VERIFICATION_TIMEOUT_SECONDS=10
KNOWLEDGE_TOTAL_TIMEOUT_SECONDS=30
# Number of ranked candidates considered before evidence assembly. Evidence
# and generation character/chunk budgets remain unchanged.
KNOWLEDGE_CANDIDATE_TOP_K=10
# DeepSeek knowledge-answer generation only.
# disabled sends {"thinking":{"type":"disabled"}} and removes reasoning tokens.
# enabled currently leaves the field absent, so api.deepseek.com uses its provider
# default; it is not an explicit request for a particular reasoning budget.
# This is independent from the agent semantic planner, whose native tool call
# adapter forces DeepSeek thinking=disabled.
KNOWLEDGE_GENERATION_THINKING=disabled
# Semantic verification quality gate. disabled is sent explicitly; enabled is
# also sent explicitly. This does not skip verification and timeout remains
# fail-closed. Compare both modes on exception/penalty and multi-claim cases.
KNOWLEDGE_VERIFICATION_THINKING=disabled
# Generation prompt only; baseline keeps the frozen production instruction.
KNOWLEDGE_GENERATION_PROMPT_STRATEGY=baseline
# Adaptive enables concise/no-thinking only for explicit single glossary questions.
# Complex rules and multipart requests always retain the fixed baseline policy.
KNOWLEDGE_GENERATION_POLICY=fixed
# Retrieval strategy notes:
# - The online path currently uses source-location-aware weighted rank fusion
#   (original dense 1.0, rewritten dense 0.5, BM25 0.25), not a learned reranker.
# - BM25/dense candidates are deduplicated by rule page or glossary anchor.
# - No Cross-Encoder/LLM reranker is enabled by default. Test reranking offline
#   on fused Top-N candidates before adding a provider/model dependency here.
# - Changing candidate_top_k changes evidence candidates, not the corpus index.
# Blank uses the historical model-bound policy. Explicit 0.43 for frozen experiments.
KNOWLEDGE_MIN_DENSE_SCORE=

# Optional local Phoenix tracing (disabled unless set to 1)
NBA_PHOENIX_ENABLED=0
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
